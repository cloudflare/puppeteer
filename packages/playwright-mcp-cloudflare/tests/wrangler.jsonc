{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "playwright-mcp-bundle-test",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "playwright-mcp-test-workers.rendering.cfdata.org",
      "custom_domain": true
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "PlaywrightMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PlaywrightMCP"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
